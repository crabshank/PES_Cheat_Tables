local v12=1 -- zoom
local v13=1 -- height

--EXTRA
local v11=1 -- pan?
local v14=-1.95 -- tilt down/up
local v21=1 -- zoom2
local v22=1 -- co-ordinate shift
local v23=5 -- pos along halfway line
local v24=1.4 -- angle mult

