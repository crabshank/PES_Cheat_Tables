local script_ref2='Camera_mod2' --  opcode_inj[vars.script_ref] stores vars
local inj_name2='INJECT'..suffix..'2'
local pattern2='^%s*subss%s+xmm%d%s*,%s*xmm%d'
local aobs2={'F3 0F 5C C3 F3 41 0F 5E CA',0,1}


[ENABLE]

