newmem:

code:
  mov [og_height_addr],rcx //store og height address
  movzx eax,byte ptr [rcx] // permanent height
    sub rsp,10
    movdqu [rsp],xmm0
  cvtsi2ss xmm0, eax //int to float
  mulss xmm0,[hgt_mult]
  cvtss2si eax, xmm0 //float to int
    movdqu xmm0,[rsp]
    add rsp,10
  mov [r8],eax
  mov al,01
  ret

INJECT_hm+5:
  jmp newmem
  nop 3

registersymbol(INJECT_hm)

