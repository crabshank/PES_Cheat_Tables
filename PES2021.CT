              <ID>1410</ID>
              <Description>"Lerp (0-1)"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>range_randRunAngles</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>1411</ID>
              <Description>"Random range (lerp: [lerp-range, lerp+range])"</Description>
              <ShowAsSigned>0</ShowAsSigned>
