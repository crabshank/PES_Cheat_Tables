--scrpts[3].Active=false -- Pre-kick rush
--scrpts[4].Active=false -- Broadcast focus
--scrpts[5].Active=false -- Angle hijack (stadium)
--scrpts[6].Active=false -- Smoother anim
--scrpts[7].Active=false -- Game speed
--scrpts[8].Active=false -- Height mod (Uses 9 and 10 too)
--scrpts[11].Active=false -- Body Size
--scrpts[12].Active=false -- Camera mod (Uses 13 and 14 too)
--scrpts[15].Active=false -- Difficulty fix
--scrpts[16].Active=false -- Additional time
--scrpts[17].Active=false -- New broadcast camera (Uses 18 and 19 too)
--scrpts[20].Active=false -- Dribble (Uses 21 and 22 too)
--scrpts[23].Active=false -- Random run angle
--scrpts[24].Active=false -- Stamina
--scrpts[25].Active=false -- Speed experiment (Uses 26-28 too)
--scrpts[29].Active=false -- Attack level experiment
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>679</ID>
          <Description>"Random animations experiment"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end

-- ---- KNOBS -----------------------------------------------------------------
local SUFFIX       = '_fj'
local EPS          = 0.07      -- jitter bound, RADIANS (HALF-angle).
                               --   visible rotation change = 2*EPS.
local MODULE_NAMES = 'PES2021.exe'
local LOOKAHEAD_N  = 32

-- ---- ARRAY GEOMETRY (derived; never hand-typed) ---------------------------
local STRIDE = 0x20
local BASE   = 0x1E0
local LAST   = 0x880

assert((LAST - BASE) % STRIDE == 0, 'array span is not a whole number of strides')
local N_SLOTS = (LAST - BASE) // STRIDE + 1        -- 54

--local DEFAULT_UNNAMED = 1

local GAIN = {}
for k = 1, N_SLOTS do GAIN[k] = 1 end
GAIN[1]=0.28
GAIN[45]=0.16

-- ---- STRINGS INTERPOLATED INTO inj_script ---------------------------------
-- All digit-leading, so bare hex is safe inside instructions.
vars_boneBase  = string.format('%X',  BASE)                 -- '1E0'
vars_boneSpan  = string.format('%X',  N_SLOTS * STRIDE)     -- '6C0'
vars_latMask   = string.format('%X',  STRIDE - 1)           -- '1F'
vars_slotShift = string.format('%X',  5)                    -- '5'
-- ----------------------------------------------------------------------------

local vars = {}
vars.boneBase  = vars_boneBase
vars.boneSpan  = vars_boneSpan
vars.latMask   = vars_latMask
vars.slotShift = vars_slotShift

-- ---- DATA BLOCKS ----------------------------------------------------------
local function gain_lines(g, n)
  local out = {}
  for k = 1, n do
	table.insert(out, string.format('dd (float)%-6s', tostring(g[k]), k))
  end
  return table.concat(out, '\n')
end

vars.jitC      = 'jitConst'..SUFFIX
vars.jitC_size = '$20'          -- 8 dwords; the abs mask needs a FULL 16 bytes
vars.jitC_d = [[dd $34000000      // +00  2^-23
dd $3F800000      // +04  1.0f
dd (float)]]..EPS..[[  // +08  epsilon
dd 0              // +0C  pad (keeps the mask 16-byte aligned)
dd $7FFFFFFF      // +10  abs mask, x4 so the
dd $7FFFFFFF      // +14   16-byte load at +10 is
dd $7FFFFFFF      // +18   entirely inside the block
dd $7FFFFFFF      // +1C  ]]
vars.gainC      = 'boneGain'..SUFFIX
vars.gainC_size = string.format('$%X', 4 * N_SLOTS)         -- '$D8'
vars.gainC_d    = gain_lines(GAIN, N_SLOTS)
-- ----------------------------------------------------------------------------

vars.post = {}

-- Aliasing: name every XMM except the instruction's own destination.
vars.post[1] = function()
  local xn = tonumber(vars.xreg_n)
  local c = 1
  for i = 0, 15 do
    if xn ~= i then
      vars['xmm~'..c] = 'xmm'..i
      c = c + 1
    end
  end
  return vars                               -- IMPORTANT!
end

vars['push_xmm'] = function(...)
  local n = select('#', ...)
  local s = 16*n
  local t = { string.format('sub rsp, %X', s) }
  for _, v in pairs({...}) do
    s = s - 16
    local r = (v == '0') and vars['x_reg'] or vars['xmm~'..v]
    table.insert(t, string.format('movdqu [rsp+%X],%s', s, r))
  end
  return table.concat(t, '\n')
end
vars['pop_xmm'] = function(...)
  local n = select('#', ...)
  local s = 16*n
  local s_og = s
  local t = {}
  for _, v in pairs({...}) do
    s = s - 16
    local r = (v == '0') and vars['x_reg'] or vars['xmm~'..v]
    table.insert(t, string.format('movdqu %s,[rsp+%X]', r, s))
  end
  table.insert(t, string.format('add rsp, %X', s_og))
  return table.concat(t, '\n')
end

-- ---- COMPULSORY plumbing ---------------------------------------------------
local newmem_name = 'newmem'..SUFFIX
local newmem_size = '$1000'
local script_ref  = 'flJitter'..SUFFIX
local inj_name    = 'INJECT'..SUFFIX

local pattern = '^%s*mulss%s+xmm%d+,%s*%[[^%]]+%]'
local parts = {
  {'xmm%d+',  1, 'x_reg'},
  {'%d+',     1, 'xreg_n'},
  {'[^%]]+',  1, 'operand_text'},
}

-- Fully pinned, no wildcards: a different build finds nothing and patches
-- nothing (fails closed).  The pattern gate still runs on the AOB path.
local aobs = {'F3 0F 59 3D 48 A8 1A 00', 0, 0}

local inj_script = [[
define(${inj_name},${address_string})
  registersymbol(${inj_name})
  alloc(${newmem_name}, ${newmem_size}, ${inj_name})

  alloc(${jitC}, ${jitC_size}, ${inj_name})
  registersymbol(${jitC})
  ${jitC}:
  ${jitC_d}

  alloc(${gainC}, ${gainC_size}, ${inj_name})
  registersymbol(${gainC})
  ${gainC}:
  ${gainC_d}

  label(return)
  label(leaveAlone)

  ${newmem_name}:
    ${og_instruction}             // ORIGINAL first, pristine regs -&gt; x_reg = theta*Cb

    push rdx
    push rcx
    push rax                      // 3 pushes              = 0x18
    ${push_xmm}(1,2,3)            // sub rsp, 30           = 0x30   total 0x48

      // ============ PHASE 1: ordinal of this slot (O(1), no scan) ==========
      // The dispatcher's pose-object pointer lives at un-pushed [rsp+220].
      // Our own traffic above is 0x18 + 0x30 = 0x48, so it is [rsp+268] here.
      // Verified by breakpoint: the slot cycles 0x1E0..0x880 and repeats.
      mov   rax, r15
      sub   rax, [rsp+268]        // slot offset within the pose object
      sub   rax, ${boneBase}      // -&gt; 0-based
      cmp   rax, ${boneSpan}
      jae   leaveAlone            // outside [0x1E0,0x880]; negative wraps high
      test  rax, ${latMask}
      jnz   leaveAlone            // off the 0x20 lattice -&gt; not a bone slot
      shr   rax, ${slotShift}     // ordinal 0..53, HELD IN RAX until PHASE 3

      // ============ PHASE 2: hash the slot pointer -&gt; random bits ==========
      // Pure function of r15, no clock: fixed per bone, so it can never become
      // per-frame vibration.  Uses rdx/rcx ONLY, so the ordinal in rax survives.
      mov   rdx, r15
      shr   rdx, 4                // drop the 16-byte alignment bits
      imul  edx, edx, 9E3779B1    // golden-ratio mix (bijection mod 2^32)
      or    edx, 1                // xorshift state must never be 0

      // ---- xorshift32, Marsaglia (13,17,5) -- all three are HEX ----------- //
      mov   ecx, edx
      shl   ecx, 0D               // 0xD = 13  (letter-leading -&gt; needs the 0)
      xor   edx, ecx
      mov   ecx, edx
      shr   ecx, 11               // 0x11 = 17 (digit-leading, safe bare)
      xor   edx, ecx
      mov   ecx, edx
      shl   ecx, 5                // 5
      xor   edx, ecx

      // ---- HIGH 23 bits -&gt; exact mantissa -&gt; u in [0,1) -&gt; v in [-1,1) ---- //
      // Shift FIRST.  Masking to 23 bits and then shifting by 9 left only 14
      // bits, pinning u near 0 and turning delta into a near-constant
      // -0.998*EPS on every bone -- a uniform skew, not randomisation.
      // High bits are also the better-quality end of a xorshift generator.
      shr   edx, 9                // 32 - 23 = 9
      cvtsi2ss ${xmm~1}, edx
      mulss  ${xmm~1}, [${jitC}]        // * 2^-23   -&gt; u in [0,1)
      addss  ${xmm~1}, ${xmm~1}         // 2u
      subss  ${xmm~1}, [${jitC}+4]      // - 1       -&gt; v in [-1,1)

      // ---- SHAPE: v*|v| = sign(v)*v^2, pushing magnitude towards 0 -------- //
      // An odd-power shaping would also work; this is the exact mirror of the
      // sqrt used elsewhere, and it keeps the sign, so E[delta] stays 0.
      movaps ${xmm~2}, ${xmm~1}
      movups ${xmm~3}, [${jitC}+10]     // 0x10..0x1F, fully inside the block
      andps  ${xmm~2}, ${xmm~3}         // |v|  (NOT andps reg,[mem]: faults)
      mulss  ${xmm~1}, ${xmm~2}         // v*|v|

      // ============ PHASE 3: scale by EPS, then the per-slot gain ==========
      mulss  ${xmm~1}, [${jitC}+8]      // * EPS
      lea    rcx, [${gainC}]
      mulss  ${xmm~1}, [rcx+rax*4]      // * gain[ordinal]  (0.0 -&gt; no-op)
      addss  ${x_reg}, ${xmm~1}         // theta += delta  (BOTH sin and cos see it)

    leaveAlone:
    ${pop_xmm}(1,2,3)
    pop rax
    pop rcx
    pop rdx                     // exact inverse of the pushes: rsp alignment on
                                // exit is identical, so the following sinf/cosf
                                // calls stay ABI-legal
    ${overwritten}
    jmp return

  ${inj_name}:
    jmp ${newmem_name}
    ${post_jmp}
  return:
]]

[ENABLE]
opcode_inj.inject(script_ref, inj_name, newmem_name, newmem_size, vars, inj_script, pattern, aobs, LOOKAHEAD_N, parts, MODULE_NAMES)

[DISABLE]
opcode_inj.disable(script_ref)
opcode_inj[script_ref] = nil
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>1350</ID>
              <Description>"Angle"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>jitConst_fj+8</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>686</ID>
          <Description>"Animation speed"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
local vars={}
--OPTIONAL (Add as named element of 'vars' table to use in '${...}' notation)
local suffix='_5'
vars.varis_1_n='mult'..suffix

local m1=1 -- mean
local r1=0 -- range
local m2=1 -- mean (ball)
local r2=0 -- range (ball)

vars.varis_1_d='dd (float)'..m1..'\ndd (float)'..r1..'\ndd (float)'..m2..'\ndd (float)'..r2
vars.varis_1_size=16

local parts={{'[^%]]+',1,'localAddress'},{'%d+',1,'xreg_n'},{'xmm%d+',1,'x_reg'},{'mov.+',1,'mov_op'}}
local module_names='PES2021.exe'
vars.post={}

vars.post[1]=function() --gives names "xmm~1" to "xmm~15" to all registers that are not 'x_reg'
 local xn=tonumber(vars.xreg_n)
 local c=1
 for i=0,15 do
  if xn~=i then
   vars['xmm~'..c]='xmm'..i
   c=c+1
  end
 end
 return vars --IMPORTANT!
end

-- token functions (below) run after ['post'] functions
vars['push_xmm']=function(...) -- n, as all arguments used for token functions, is necessarily a string!
  local n = select('#', ...) -- number of args
  local s=16*n
  local t={}
  local p=string.format('sub rsp, %X',s)
  table.insert(t,p)
  local args = {...}
  for _, v in pairs(args) do
      s=s-16
      local r=vars['xmm~'..v]
      if v=='0' then
	     r=vars['x_reg']
      end
      p=string.format('movdqu [rsp+%X],%s',s,r)
      table.insert(t,p)
  end
  return table.concat(t,'\n')
end

vars['pop_xmm']=function(...) -- n, as all arguments used for token functions, is necessarily a string!
  local n = select('#', ...) -- number of args
  local s=16*n
  local s_og=s
  local t={}
  local args = {...}
  local p=''
  for _, v in pairs(args) do
      s=s-16
      local r=vars['xmm~'..v]
      if v=='0' then
      	r=vars['x_reg']
      end
      p=string.format('movdqu %s,[rsp+%X]',r,s)
      table.insert(t,p)
  end
  p=string.format('add rsp, %X',s_og)
  table.insert(t,p)
  return table.concat(t,'\n')
end

vars['stack_push']=function(n) -- n, as all arguments used for token functions, is necessarily a string!
		return 'sub rsp, ' .. n
end

vars['stack_pop']=function(n) -- n, as all arguments used for token functions, is necessarily a string!
		return 'add rsp, ' .. n
end

--COMPULSORY
local newmem_name='newmem'..suffix
local newmem_size='$1000'
local script_ref='Animation_speed' --  opcode_inj[vars.script_ref] stores vars
local inj_name='INJECT'..suffix
local pattern='^%s*movss%s*%[[^%]]+%]%s*,%s*xmm%d+'
local aobs={'48 8B 40 10 F3 0F 11 48 44',0,16}
local lookahead_n=32

local inj_script=[[
  define(${inj_name},${address_string})
  registersymbol(${inj_name})
  alloc(${newmem_name}, ${newmem_size}, ${inj_name})

  alloc(${varis_1_n}, $%d{varis_1_size}, ${inj_name})
  registersymbol(${varis_1_n})
  ${varis_1_n}:
  ${varis_1_d}

  label(code)
  label(code2)
  label(code3)
  label(return)


  ${newmem_name}:
  code:
    push rcx
    push rdx
    push rax

    mov rax,[7FFE0014] //Windows internal clock
    mov rdx,rax
    shl rdx,6
    mov rcx,rax
    shl rcx,18
    imul rcx,rdx
    imul rcx,rax
    shr rcx,20 //ecx has the number
    ${push_xmm}(1,2,3,4,5)
    ${push_xmm}(0)


    cvtsi2ss ${x_reg}, rcx
    cvtss2sd ${x_reg}, ${x_reg}

    ${stack_push}(8)
        mov [rsp],FFE00000
        mov [rsp+4],41EFFFFF //move max_float into stack
        divsd ${x_reg}, [rsp] //div by max float (in double precision)
    ${stack_pop}(8)

    cvtsd2ss ${x_reg}, ${x_reg} //random float in ${x_reg}

    cvtss2si ecx, ${x_reg}  //b as int
    cvtsi2ss  ${xmm~5}, ecx // b

    ${stack_push}(10)
        mov [rsp], C0000000 //-2
        mov [rsp+4], 3F800000 //1
        mov [rsp+8], 40000000 //2
        mov [rsp+C], 3F3504F3 //sqHalf

        movss ${xmm~1},  [rsp+C] //sqHalf
        movss ${xmm~2}, [rsp] //-2
        movss ${xmm~3}, [rsp+4] //1
        movss ${xmm~4}, [rsp+8] //2

        mulss ${xmm~4}, ${xmm~5} //x~4=b*2
        subss ${xmm~3}, ${xmm~4} // x~3=1-b*2
        mulss ${xmm~1}, ${xmm~3} // x~1 = ( sqHalf* (1-b*2) )
        mulss ${xmm~2}, ${xmm~5} //x~2 = -2*b
        mulss ${xmm~2}, ${x_reg} // x~2=(-2*b)*x
        addss ${xmm~2}, ${xmm~5}//x~2=(-2*b*x)+b
        addss ${xmm~2}, ${x_reg} // x~2=(-2*b*x)+b+x
        sqrtss ${xmm~2}, ${xmm~2} // // x~2=sqrt(-2*b*x+b+x)
        mulss  ${xmm~1},${xmm~2} // x~1 = ( sqHalf* (1-b*2) )*sqrt(-2*b*x+b+x)
        addss ${xmm~1}, ${xmm~5} //  x~1 = b+ ( sqHalf* (1-b*2) )*sqrt(-2*b*x+b+x) || FINAL!
    ${stack_pop}(10)

    mov rax,[inv_hgt_mult]
    cmp rax,rbx

    jne code2
    movss  ${xmm~4},  [${varis_1_n}+4] // NO BALL!
    movss  ${xmm~3},  [${varis_1_n}] //u
    jmp code3

    code2:
    movss  ${xmm~4},  [${varis_1_n}+C] // BALL!
    movss  ${xmm~3},  [${varis_1_n}+8] //u

    code3:
    subss  ${xmm~3},  ${xmm~4}
    mulss  ${xmm~4},  ${xmm~1} //mul by adj_x
    addss  ${xmm~4},  ${xmm~4}
    addss  ${xmm~4},  ${xmm~3} //FINAL MULT in x~4 !

    ${pop_xmm}(0)
	mulss ${x_reg},${xmm~4}
    ${pop_xmm}(1,2,3,4,5)
    pop rax
    pop rdx
    pop rcx
    ${og_instruction}

    ${overwritten}
    jmp return

  ${inj_name}:
  jmp ${newmem_name}
  ${post_jmp}
  return:
]]

[ENABLE]
local sc1=[[aobscanmodule(INJECT_hm2,PES2021.exe,F3 0F 10 4A 28 F3 0F 11 04 24 F3 0F 10 42 24 F3 0F 11 44 24 08) // should be unique
alloc(newmem2,$1000,INJECT_hm2)

label(code2)
label(return2)

alloc(inv_hgt_mult, 8, INJECT_hm2)
registersymbol(inv_hgt_mult)
inv_hgt_mult:
db 00 00 00 00 00 00 00 00

newmem2:

code2:
  movss xmm1,[rdx+28]
  mov [inv_hgt_mult],rdi
  jmp return2

INJECT_hm2:
  jmp newmem2
return2:
registersymbol(INJECT_hm2)]]
autoAssemble(sc1)

opcode_inj.inject(script_ref,inj_name,newmem_name,newmem_size,vars,inj_script,pattern,aobs,lookahead_n,parts,module_names)

[DISABLE]
local sc2=[[unregistersymbol(inv_hgt_mult)
dealloc(inv_hgt_mult)

INJECT_hm2:
  db F3 0F 10 4A 28 F3 0F 11 04 24 F3 0F 10 42 24 F3 0F 11 44 24 08

unregistersymbol(INJECT_hm2)
dealloc(newmem2)]]
autoAssemble(sc2)

opcode_inj.disable(script_ref)
opcode_inj[script_ref]=nil
</AssemblerScript>
