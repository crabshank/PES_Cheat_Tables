                  <AssemblerScript>[ENABLE]

aobscanmodule(INJECT_speed_towards_goal,PES2021.exe,08 00 00 00 0F 46 C2 C3 CC) // should be unique
alloc(newmem,$1000,INJECT_speed_towards_goal)

label(code)
label(return)

newmem:

code:
  mov eax,00000001
  ret

INJECT_speed_towards_goal+04:
