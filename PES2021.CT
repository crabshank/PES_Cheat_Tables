          <ID>1354</ID>
          <Description>"Random animations experiment"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
-- ============================================================================

-- ---- KNOBS -----------------------------------------------------------------
local SUFFIX       = '_fj'
local EPS          = 0.06     -- jitter bound, RADIANS (HALF-angle).
                             --   visible rotation change = 2*EPS.
local MODULE_NAMES = 'PES2021.exe'
local LOOKAHEAD_N  = 32

-- Bone table
local BONE_OFFSETS = {
  0x1E0, 0x320, 0x360, 0x3A0, 0x440, 0x480, 0x4C0, 0x500, 0x540, 0x580,
  0x5C0, 0x600, 0x6A0, 0x6E0, 0x720, 0x760, 0x800, 0x840, 0x880,
}
local BONE_NAMES = {
  'root_hip',
  'thigh_l','leg_l','foot_l',
  'thigh_r','leg_r','foot_r',
  'belly','chest','neck','head',
  'shoulder_l','upperarm_l','forearm_l','hand_l',
  'shoulder_r','upperarm_r','forearm_r','hand_r',
}
-- Per-bone multiplier on EPS.  0 = leave the authored rotation alone.
local BONE_GAIN = {
  0,        --  0 root_hip     (drives the whole tree)
  1, 1, 1,  --  1 thigh_l   2 leg_l      3 foot_l
  1, 1, 1,  --  4 thigh_r   5 leg_r      6 foot_r
  1, 0.32, 1, 1,--  7 belly     8 chest      9 neck      10 head
  1, 1, 1, 1,-- 11 shoulder_l 12 upperarm_l 13 forearm_l 14 hand_l
  1, 1, 1, 1,-- 15 shoulder_r 16 upperarm_r 17 forearm_r 18 hand_r
  0,        -- 19 UNKNOWN slot  (fail closed)
}
-- ----------------------------------------------------------------------------

local vars = {}

-- Emit the tables as CE auto-assembler data lines.
local function dd_floats(vals, names)
  local out = {}
  for i, v in ipairs(vals) do
    local nm = names and names[i] or (i == #vals and 'UNKNOWN slot' or '?')
    out[#out+1] = string.format('dd (float)%-5s // %2d %s', tostring(v), i-1, nm)
  end
  return table.concat(out, '\n')
end
local function dd_hex(vals, names)
  local out = {}
  for i, v in ipairs(vals) do
    out[#out+1] = string.format('dd $%-5X // %2d %s', v, i-1, names[i])
  end
  return table.concat(out, '\n')
end

vars.jitC        = 'jitConst'..SUFFIX
vars.jitC_size   = 16      -- 4 dwords
vars.jitC_d = [[dd $34000000        // 2^-23
dd $3F800000        // 1.0f
dd (float)]]..EPS..[[   // epsilon
dd $7FFFFFFF        // abs mask (sign-bit clear) ]]

vars.offsC       = 'boneOffs'..SUFFIX
vars.offsC_size  = string.format('$%X', 4*#BONE_OFFSETS)
vars.offsC_d     = dd_hex(BONE_OFFSETS, BONE_NAMES)

vars.gainC       = 'boneGain'..SUFFIX
vars.gainC_size  = string.format('$%X', 4*#BONE_GAIN)
vars.gainC_d     = dd_floats(BONE_GAIN, BONE_NAMES)

vars.post = {}

-- Aliasing: name every XMM except the instruction's own destination.
vars.post[1] = function()
  local xn = tonumber(vars.xreg_n)
  local c = 1
  for i = 0, 15 do
    if xn ~= i then
      vars['xmm~'..c] = 'xmm'..i
      c = c + 1
    end
  end
  return vars                               -- IMPORTANT!
end

vars['push_xmm'] = function(...)
  local n = select('#', ...)
  local s = 16*n
  local t = { string.format('sub rsp, %X', s) }
  for _, v in pairs({...}) do
    s = s - 16
    local r = (v == '0') and vars['x_reg'] or vars['xmm~'..v]
    table.insert(t, string.format('movdqu [rsp+%X],%s', s, r))
  end
  return table.concat(t, '\n')
end
vars['pop_xmm'] = function(...)
  local n = select('#', ...)
  local s = 16*n
  local s_og = s
  local t = {}
  for _, v in pairs({...}) do
    s = s - 16
    local r = (v == '0') and vars['x_reg'] or vars['xmm~'..v]
    table.insert(t, string.format('movdqu %s,[rsp+%X]', r, s))
  end
  table.insert(t, string.format('add rsp, %X', s_og))
  return table.concat(t, '\n')
end

local newmem_name = 'newmem'..SUFFIX
local newmem_size = '$1000'
local script_ref  = 'flJitter'..SUFFIX
local inj_name    = 'INJECT'..SUFFIX

local pattern = '^%s*mulss%s+xmm%d+,%s*%[[^%]]+%]'
local parts = {
  {'xmm%d+',  1, 'x_reg'},
  {'%d+',     1, 'xreg_n'},
  {'[^%]]+',  1, 'operand_text'},
}

local aobs = {'F3 0F 59 3D 48 A8 1A 00', 0, 0}

local inj_script = [[
define(${inj_name},${address_string})
  registersymbol(${inj_name})
  alloc(${newmem_name}, ${newmem_size}, ${inj_name})

  alloc(${jitC}, ${jitC_size}, ${inj_name})
  registersymbol(${jitC})
  ${jitC}:
  ${jitC_d}

  alloc(${offsC}, ${offsC_size}, ${inj_name})
  registersymbol(${offsC})
  ${offsC}:
  ${offsC_d}

  alloc(${gainC}, ${gainC_size}, ${inj_name})
  registersymbol(${gainC})
  ${gainC}:
  ${gainC_d}

  label(return)
  label(boneScan)
  label(boneDone)

  ${newmem_name}:
    ${og_instruction}             // ORIGINAL first, pristine regs -&gt; x_reg = theta*Cb

    push rdx
    push rcx
    push rax                      // 3 pushes = 0x18
    ${push_xmm}(1,2,3)

      // ================= PHASE 1: which bone is this? ======================
      // Pose-object pointer lives in the DISPATCHER's frame at un-pushed
      // [rsp+220]; A1 makes no stack adjustment between here and its tail, so
      // the same slot applies at this site.  Add back our own 0x28 + 0x20.
      mov   rax, r15
      sub   rax, [rsp+248+20]        // 0x220 + 0x28 +0x20  -&gt;  byte offset of this slot
      mov   edx, 13              // 0x13 = 19 = index of the UNKNOWN gain
      cmp   rax, 1000
      ja    boneDone              // outside the object (or negative, unsigned)
      lea   rcx, [${offsC}]
      xor   edx, edx
    boneScan:
      cmp   eax, [rcx+rdx*4]      // eax == rax here: rax already range-checked &lt; 0x1000
      je    boneDone              // matched -&gt; edx = bone index
      inc   edx
      cmp   edx, 13
      jb    boneScan
      mov   edx, 13              // ran off the table -&gt; UNKNOWN
    boneDone:

      // ================= PHASE 2: hash the slot pointer ====================
      // Pure function of r15, no clock: the offset is FIXED per bone, so it
      // can never become per-frame vibration.
      mov   rax, r15
      shr   rax, 4               // drop the 16-byte alignment bits
      imul  eax, eax, 9E3779B1   // golden-ratio mix
      or    eax, 1               // xorshift state must never be 0

      // ---- xorshift32, Marsaglia (13,17,5) -- 0xD, 0x11, 0x5 are HEX ----------- //
      mov   ecx, eax
      shl   ecx, D
      xor   eax, ecx
      mov   ecx, eax
      shr   ecx, 11
      xor   eax, ecx
      mov   ecx, eax
      shl   ecx, 5
      xor   eax, ecx

      // ============ PHASE 3: 23 bits -&gt; u -&gt; 2u-1 -&gt; *EPS -&gt; *gain =========
      // BUGFIX: shift FIRST (high 23 bits).  The old order (mask to 23 bits,
      // THEN shift by 9) left only 14 bits, so u was pinned near 0 and delta
      // was a near-constant -0.998*EPS on every bone -- a uniform 23-degree
      // skew, not randomisation.  High bits are also the better-quality end
      // of a xorshift generator.
      shr    eax, 9              // 32 - 23 = 9; result is exactly 23 bits
      cvtsi2ss ${xmm~1}, eax
      mulss  ${xmm~1}, [${jitC}]        // * 2^-23   -&gt; u in [0,1)
      addss  ${xmm~1}, ${xmm~1}         // 2u
      subss  ${xmm~1}, [${jitC}+4]      // - 1       -&gt; [-1,1)

      movaps ${xmm~2}, ${xmm~1}
      movups ${xmm~3}, [${jitC}+C]    // unaligned load of the abs mask
      andps  ${xmm~2}, ${xmm~3}         // |v|   (NOT andps reg,[mem]: would fault)
      mulss  ${xmm~1}, ${xmm~2}         // v*|v| = sign(v)*v^2

      mulss  ${xmm~1}, [${jitC}+8]      // * EPS     -&gt; [-EPS,+EPS)
      lea    rcx, [${gainC}]
      mulss  ${xmm~1}, [rcx+rdx*4]      // * per-bone gain (0.0 -&gt; no-op)

      addss  ${x_reg}, ${xmm~1}         // theta += delta (BOTH sin and cos see it)

    ${pop_xmm}(1,2,3)
    pop rax
    pop rcx
    pop rdx                     // exact inverse of the pushes: rsp alignment
                                // on exit is identical, so the following
                                // sinf/cosf calls stay ABI-legal
    ${overwritten}
    jmp return

  ${inj_name}:
    jmp ${newmem_name}
    ${post_jmp}
  return:
]]

[ENABLE]
opcode_inj.inject(script_ref, inj_name, newmem_name, newmem_size, vars, inj_script, pattern, aobs, LOOKAHEAD_N, parts, MODULE_NAMES)

[DISABLE]
opcode_inj.disable(script_ref)
opcode_inj[script_ref] = nil
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>1355</ID>
              <Description>"Angle"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>jitConst_fj+8</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>1356</ID>
              <Description>"Internal"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1357</ID>
                  <Description>"BONE_GAIN root"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Float</VariableType>
                  <Address>boneGain_fj</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>1358</ID>
          <Description>"Animation speed"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
local vars={}
--OPTIONAL (Add as named element of 'vars' table to use in '${...}' notation)
local suffix='_5'
vars.varis_1_n='mult'..suffix

local m1=1 -- mean
local r1=0 -- range
local m2=1 -- mean (ball)
local r2=0 -- range (ball)

vars.varis_1_d='dd (float)'..m1..'\ndd (float)'..r1..'\ndd (float)'..m2..'\ndd (float)'..r2
vars.varis_1_size=16

local parts={{'[^%]]+',1,'localAddress'},{'%d+',1,'xreg_n'},{'xmm%d+',1,'x_reg'},{'mov.+',1,'mov_op'}}
local module_names='PES2021.exe'
vars.post={}

vars.post[1]=function() --gives names "xmm~1" to "xmm~15" to all registers that are not 'x_reg'
 local xn=tonumber(vars.xreg_n)
 local c=1
 for i=0,15 do
  if xn~=i then
   vars['xmm~'..c]='xmm'..i
   c=c+1
  end
 end
 return vars --IMPORTANT!
end

-- token functions (below) run after ['post'] functions
vars['push_xmm']=function(...) -- n, as all arguments used for token functions, is necessarily a string!
  local n = select('#', ...) -- number of args
  local s=16*n
  local t={}
  local p=string.format('sub rsp, %X',s)
  table.insert(t,p)
  local args = {...}
  for _, v in pairs(args) do
      s=s-16
      local r=vars['xmm~'..v]
      if v=='0' then
	     r=vars['x_reg']
      end
      p=string.format('movdqu [rsp+%X],%s',s,r)
      table.insert(t,p)
  end
  return table.concat(t,'\n')
end

vars['pop_xmm']=function(...) -- n, as all arguments used for token functions, is necessarily a string!
  local n = select('#', ...) -- number of args
  local s=16*n
  local s_og=s
  local t={}
  local args = {...}
  local p=''
  for _, v in pairs(args) do
      s=s-16
      local r=vars['xmm~'..v]
      if v=='0' then
      	r=vars['x_reg']
      end
      p=string.format('movdqu %s,[rsp+%X]',r,s)
      table.insert(t,p)
  end
  p=string.format('add rsp, %X',s_og)
  table.insert(t,p)
  return table.concat(t,'\n')
end

vars['stack_push']=function(n) -- n, as all arguments used for token functions, is necessarily a string!
		return 'sub rsp, ' .. n
end

vars['stack_pop']=function(n) -- n, as all arguments used for token functions, is necessarily a string!
		return 'add rsp, ' .. n
end

--COMPULSORY
local newmem_name='newmem'..suffix
local newmem_size='$1000'
local script_ref='Animation_speed' --  opcode_inj[vars.script_ref] stores vars
local inj_name='INJECT'..suffix
local pattern='^%s*movss%s*%[[^%]]+%]%s*,%s*xmm%d+'
local aobs={'48 8B 40 10 F3 0F 11 48 44',0,16}
local lookahead_n=32

local inj_script=[[
  define(${inj_name},${address_string})
  registersymbol(${inj_name})
  alloc(${newmem_name}, ${newmem_size}, ${inj_name})

  alloc(${varis_1_n}, $%d{varis_1_size}, ${inj_name})
  registersymbol(${varis_1_n})
  ${varis_1_n}:
  ${varis_1_d}

  label(code)
  label(code2)
  label(code3)
  label(return)


  ${newmem_name}:
  code:
    push rcx
    push rdx
    push rax

    mov rax,[7FFE0014] //Windows internal clock
    mov rdx,rax
    shl rdx,6
    mov rcx,rax
    shl rcx,18
    imul rcx,rdx
    imul rcx,rax
    shr rcx,20 //ecx has the number
    ${push_xmm}(1,2,3,4,5)
    ${push_xmm}(0)


    cvtsi2ss ${x_reg}, rcx
    cvtss2sd ${x_reg}, ${x_reg}

    ${stack_push}(8)
        mov [rsp],FFE00000
        mov [rsp+4],41EFFFFF //move max_float into stack
        divsd ${x_reg}, [rsp] //div by max float (in double precision)
    ${stack_pop}(8)

    cvtsd2ss ${x_reg}, ${x_reg} //random float in ${x_reg}

    cvtss2si ecx, ${x_reg}  //b as int
    cvtsi2ss  ${xmm~5}, ecx // b

    ${stack_push}(10)
        mov [rsp], C0000000 //-2
        mov [rsp+4], 3F800000 //1
        mov [rsp+8], 40000000 //2
        mov [rsp+C], 3F3504F3 //sqHalf

        movss ${xmm~1},  [rsp+C] //sqHalf
        movss ${xmm~2}, [rsp] //-2
        movss ${xmm~3}, [rsp+4] //1
        movss ${xmm~4}, [rsp+8] //2

        mulss ${xmm~4}, ${xmm~5} //x~4=b*2
        subss ${xmm~3}, ${xmm~4} // x~3=1-b*2
        mulss ${xmm~1}, ${xmm~3} // x~1 = ( sqHalf* (1-b*2) )
        mulss ${xmm~2}, ${xmm~5} //x~2 = -2*b
        mulss ${xmm~2}, ${x_reg} // x~2=(-2*b)*x
        addss ${xmm~2}, ${xmm~5}//x~2=(-2*b*x)+b
        addss ${xmm~2}, ${x_reg} // x~2=(-2*b*x)+b+x
        sqrtss ${xmm~2}, ${xmm~2} // // x~2=sqrt(-2*b*x+b+x)
        mulss  ${xmm~1},${xmm~2} // x~1 = ( sqHalf* (1-b*2) )*sqrt(-2*b*x+b+x)
        addss ${xmm~1}, ${xmm~5} //  x~1 = b+ ( sqHalf* (1-b*2) )*sqrt(-2*b*x+b+x) || FINAL!
    ${stack_pop}(10)

    mov rax,[inv_hgt_mult]
    cmp rax,rbx

    jne code2
    movss  ${xmm~4},  [${varis_1_n}+4] // NO BALL!
    movss  ${xmm~3},  [${varis_1_n}] //u
    jmp code3

    code2:
    movss  ${xmm~4},  [${varis_1_n}+C] // BALL!
    movss  ${xmm~3},  [${varis_1_n}+8] //u

    code3:
    subss  ${xmm~3},  ${xmm~4}
    mulss  ${xmm~4},  ${xmm~1} //mul by adj_x
    addss  ${xmm~4},  ${xmm~4}
    addss  ${xmm~4},  ${xmm~3} //FINAL MULT in x~4 !

    ${pop_xmm}(0)
	mulss ${x_reg},${xmm~4}
    ${pop_xmm}(1,2,3,4,5)
    pop rax
    pop rdx
    pop rcx
    ${og_instruction}

    ${overwritten}
    jmp return

  ${inj_name}:
  jmp ${newmem_name}
  ${post_jmp}
  return:
]]

[ENABLE]
local sc1=[[aobscanmodule(INJECT_hm2,PES2021.exe,F3 0F 10 4A 28 F3 0F 11 04 24 F3 0F 10 42 24 F3 0F 11 44 24 08) // should be unique
alloc(newmem2,$1000,INJECT_hm2)

label(code2)
label(return2)

alloc(inv_hgt_mult, 8, INJECT_hm2)
registersymbol(inv_hgt_mult)
inv_hgt_mult:
db 00 00 00 00 00 00 00 00

newmem2:

code2:
  movss xmm1,[rdx+28]
  mov [inv_hgt_mult],rdi
  jmp return2

INJECT_hm2:
  jmp newmem2
return2:
registersymbol(INJECT_hm2)]]
autoAssemble(sc1)

opcode_inj.inject(script_ref,inj_name,newmem_name,newmem_size,vars,inj_script,pattern,aobs,lookahead_n,parts,module_names)

[DISABLE]
local sc2=[[unregistersymbol(inv_hgt_mult)
dealloc(inv_hgt_mult)

INJECT_hm2:
  db F3 0F 10 4A 28 F3 0F 11 04 24 F3 0F 10 42 24 F3 0F 11 44 24 08

unregistersymbol(INJECT_hm2)
dealloc(newmem2)]]
autoAssemble(sc2)

opcode_inj.disable(script_ref)
opcode_inj[script_ref]=nil
</AssemblerScript>
