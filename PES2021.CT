--scrpts[5].Active=true -- Angle hijack (stadium)
--scrpts[6].Active=true -- Smoother anim
--scrpts[7].Active=true -- Game speed
--scrpts[8].Active=true -- Height mod (Uses 9 and 10 too)
--scrpts[11].Active=true -- Body Size
--scrpts[12].Active=true -- Camera mod (Uses 13 and 14 too)
--scrpts[15].Active=true -- Difficulty fix
--scrpts[16].Active=true -- Additional time
--scrpts[17].Active=true -- New broadcast camera (Uses 18 and 19 too)
--scrpts[20].Active=true -- Dribble (Uses 21 and 22 too)
--scrpts[23].Active=true -- Random run angle
